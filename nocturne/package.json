{
  "name": "nocturne",
  "version": "0.1.0",
  "description": "Nocturne: an original music streaming web app (Next.js + Supabase) with a synthesised CC0 demo catalogue.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "catalog": "node scripts/generate-catalog.mjs",
    "catalog:seed": "node scripts/generate-catalog.mjs --seed-only",
    "db:start": "supabase start -x studio,realtime,edge-runtime,logflare,vector,supavisor,imgproxy,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "setup": "npm run catalog && npm run db:start && npm run db:reset"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "private": true
}
