# Supabase project. For local development `npm run db:start` prints these values
# (API_URL and PUBLISHABLE_KEY / ANON_KEY). For a hosted project: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only used by the Playwright tests to create and clean up throwaway test users.
# Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
